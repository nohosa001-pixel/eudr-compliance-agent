# ==============================================================================
# eudragent.com - Production Environment Configuration
# ==============================================================================

# Project & Domain Information
PROJECT_NAME="EUDRAgent.com Enterprise Platform"
DOMAIN_NAME=eudragent.com
ADMIN_EMAIL=admin@eudragent.com

# PostgreSQL 16 + PostGIS 3.4
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_POSTGRES_PWD
POSTGRES_DB=eudr_compliance
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PRODUCTION_POSTGRES_PWD@db:5432/eudr_compliance

# Redis Broker & Celery Queue
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
USE_DISTRIBUTED_QUEUE=true

# Security & Cryptographic Digital Signatures (HMAC-SHA256)
SECRET_KEY_FOR_SIGNING=CHANGE_ME_SUPER_SECRET_HMAC_KEY_2026

# Copernicus Sentinel-2 CDSE API Credentials (Optional live mode)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
USE_LIVE_COPERNICUS_API=false

# Stripe Global Payments Configuration (EUR / USD / Credit Cards / SEPA)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram Real-Time Financial & Lead Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web3 / MetaMask Polygon (PoS) Settlement Configuration (Main Chain: Polygon Mainnet, ID: 137)
POLYGON_METAMASK_WALLET_ADDRESS=0x255F9991233f86B29dB847c8d5b8CB9915e80dCf
POLYGON_CHAIN_ID=137
POLYGON_RPC_URL=https://polygon-rpc.com

# Glama.ai Inter-Agent Mesh MCP Endpoints (@nohosa001-pixel)
SECURITY_GATE_MCP_URL=https://glama.ai/mcp/servers/nohosa001-pixel/security-gate-x402
CLEANWEB_MCP_URL=https://glama.ai/mcp/servers/nohosa001-pixel/x402-cleanweb-agent
MINERALS_ORACLE_MCP_URL=https://glama.ai/mcp/servers/nohosa001-pixel/minerals-oracle-x402
